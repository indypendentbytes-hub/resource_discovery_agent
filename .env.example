# Server-side only. Never prefix this variable with VITE_.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Clerk Auth (https://dashboard.clerk.com)
# Publishable key is safe to expose to the browser (VITE_ prefix required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key is server-only — never put VITE_ in front of it
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
