# Server-side only. Never prefix secret keys with VITE_.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Clerk Auth (https://dashboard.clerk.com)
# Publishable key is safe in the browser (VITE_ prefix required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key is server-only — never put VITE_ in front of it
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qdrant (https://cloud.qdrant.io / self-hosted)
# Server-only — used by /api/qdrant-* routes
QDRANT_URL=https://YOUR-CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=replace_with_your_qdrant_api_key
QDRANT_COLLECTION=resources
