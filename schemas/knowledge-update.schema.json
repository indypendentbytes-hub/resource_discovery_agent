{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indypendentbytes.org/schemas/knowledge-update.schema.json",
  "title": "Resource Discovery Agent Knowledge Update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "update_id",
    "source_id",
    "change_type",
    "status",
    "source_url",
    "source_organization",
    "authority_class",
    "retrieved_at",
    "evidence",
    "proposed_changes",
    "confidence",
    "risk_level"
  ],
  "properties": {
    "update_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "change_type": {
      "type": "string",
      "enum": ["NEW", "UPDATED", "EXPIRED", "CONFLICT", "UNVERIFIED"]
    },
    "status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "EXTRACTED",
        "VALIDATION_PENDING",
        "CONFLICT_REVIEW",
        "APPROVAL_PENDING",
        "APPROVED",
        "PUBLISHED",
        "REJECTED",
        "ARCHIVED"
      ]
    },
    "source_url": {"type": "string", "format": "uri"},
    "source_organization": {"type": "string", "minLength": 1},
    "authority_class": {
      "type": "string",
      "enum": [
        "LAW_OR_REGULATION",
        "OFFICIAL_GOVERNMENT_PROGRAM",
        "OFFICIAL_PROVIDER",
        "UNIVERSITY_OR_EXTENSION",
        "VERIFIED_PARTNER_KNOWLEDGE",
        "REPUTABLE_SECONDARY",
        "DIRECTORY_OR_AGGREGATOR",
        "COMMUNITY_SUBMISSION"
      ]
    },
    "retrieved_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "supporting_text", "source_url"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "supporting_text": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "new_value"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "old_value": {},
          "new_value": {},
          "reason": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "material_fields_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "eligibility",
          "legal_or_compliance",
          "funding_amount",
          "deadline",
          "cost",
          "service_area",
          "application_route",
          "contact",
          "program_status",
          "partner_specific_knowledge"
        ]
      },
      "uniqueItems": true
    },
    "affected_resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affected_pathway_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requires_human_review": {"type": "boolean", "default": true},
    "review": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "decision": {"type": "string", "enum": ["APPROVE", "EDIT", "REJECT", "ARCHIVE"]},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "publication": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "published_at": {"type": "string", "format": "date-time"},
        "published_by": {"type": "string"},
        "previous_version_id": {"type": ["string", "null"]},
        "new_version_id": {"type": "string"},
        "search_index_rebuilt": {"type": "boolean"},
        "recommendations_recomputed": {"type": "boolean"}
      }
    }
  }
}
