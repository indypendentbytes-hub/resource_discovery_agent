{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indypendentbytes.org/schemas/entity-profile.schema.json",
  "title": "Resource Discovery Agent Entity Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "name",
    "entity_type",
    "canonical_url",
    "description",
    "knowledge_base_category",
    "tags",
    "verification_status",
    "sources",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "legal_name": {"type": ["string", "null"]},
    "alternate_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entity_type": {
      "type": "string",
      "enum": [
        "GOVERNMENT_AGENCY",
        "NONPROFIT",
        "BUSINESS",
        "UNIVERSITY_OR_EXTENSION",
        "FUNDER",
        "PROGRAM",
        "SERVICE_PROVIDER",
        "COMMUNITY_ORGANIZATION",
        "INDIVIDUAL",
        "OTHER"
      ]
    },
    "canonical_url": {"type": "string", "format": "uri"},
    "google_business_profile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "place_id": {"type": ["string", "null"]},
        "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "review_count": {"type": ["integer", "null"], "minimum": 0},
        "last_checked_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url"],
        "properties": {
          "platform": {"type": "string", "enum": ["FACEBOOK", "INSTAGRAM", "LINKEDIN", "X", "YOUTUBE", "TIKTOK", "OTHER"]},
          "url": {"type": "string", "format": "uri"},
          "handle": {"type": ["string", "null"]},
          "verified": {"type": "boolean", "default": false}
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "relationship", "verification_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "enum": ["OWNER", "FOUNDER", "COFOUNDER", "PARENT_ORGANIZATION", "OTHER"]},
          "verification_status": {"type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED"]},
          "source_url": {"type": ["string", "null"], "format": "uri"}
        }
      }
    },
    "management": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "verification_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "verification_status": {"type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED"]},
          "source_url": {"type": ["string", "null"], "format": "uri"}
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": ["string", "null"]},
          "address_line_1": {"type": ["string", "null"]},
          "address_line_2": {"type": ["string", "null"]},
          "city": {"type": ["string", "null"]},
          "state": {"type": ["string", "null"]},
          "postal_code": {"type": ["string", "null"]},
          "country": {"type": ["string", "null"]},
          "latitude": {"type": ["number", "null"]},
          "longitude": {"type": ["number", "null"]},
          "service_area": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "verification_status": {"type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED"]}
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "rating", "review_count", "retrieved_at"],
        "properties": {
          "platform": {"type": "string"},
          "rating": {"type": "number", "minimum": 0, "maximum": 5},
          "review_count": {"type": "integer", "minimum": 0},
          "url": {"type": ["string", "null"], "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "description": {"type": "string", "minLength": 1},
    "knowledge_base_category": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "programs_and_services": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "usefulness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_useful", "reason"],
      "properties": {
        "is_useful": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "verification_status": {"type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "CONFLICT_REVIEW"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source_type", "retrieved_at"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "source_type": {"type": "string"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "supports_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "previous_version_id": {"type": ["string", "null"]}
  }
}
